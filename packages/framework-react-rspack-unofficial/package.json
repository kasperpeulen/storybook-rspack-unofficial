{
  "name": "storybook-react-rspack-unofficial",
  "version": "0.0.1",
  "description": "Storybook framework for React with rspack",
  "keywords": [
    "storybook",
    "storybook-framework",
    "react",
    "rspack"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./preset": {
      "types": "./dist/preset.d.ts",
      "default": "./dist/preset.js"
    },
    "./loaders/react-docgen-loader": "./dist/loaders/react-docgen-loader.js",
    "./loaders/react-docgen-typescript-loader": "./dist/loaders/react-docgen-typescript-loader.js",
    "./plugins/react-docgen-typescript-worker": "./dist/plugins/react-docgen-typescript-worker.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "*.js",
    "*.d.ts",
    "!src/**/*"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@rollup/pluginutils": "^5.3.0",
    "@storybook/react": "^10.2.19",
    "storybook-builder-rspack-unofficial": "workspace:*",
    "empathic": "^2.0.0",
    "magic-string": "^0.30.21",
    "react-docgen": "^8.0.3",
    "react-docgen-typescript": "^2.4.0",
    "resolve": "^1.22.11",
    "tsconfig-paths": "^4.2.0"
  },
  "devDependencies": {
    "@rspack/core": "^1.7.9",
    "@types/react": "^19.2.14",
    "@types/resolve": "^1.20.6",
    "react": "^19.2.4",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@rspack/core": "^1.0.0",
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "storybook": "^10.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
