{
  "name": "storybook-builder-rspack-unofficial",
  "version": "0.0.1",
  "description": "A Storybook builder that uses rspack directly",
  "keywords": [
    "storybook",
    "storybook-builder",
    "rspack",
    "builder",
    "bundler"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/7rulnik/storybook-rspack-unofficial",
    "directory": "packages/builder-rspack-unofficial"
  },
  "homepage": "https://github.com/7rulnik/storybook-rspack-unofficial#readme",
  "bugs": "https://github.com/7rulnik/storybook-rspack-unofficial/issues",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./loaders/export-order-loader": "./dist/loaders/export-order-loader.js",
    "./loaders/storybook-mock-transform-loader": "./dist/loaders/storybook-mock-transform-loader.js",
    "./loaders/rspack-automock-loader": "./dist/loaders/rspack-automock-loader.js",
    "./package.json": "./package.json",
    "./presets/custom-rspack-preset": "./dist/presets/custom-rspack-preset.js",
    "./presets/preview-preset": "./dist/presets/preview-preset.js",
    "./templates/preview.ejs": "./templates/preview.ejs",
    "./templates/virtualModuleModernEntry.js": "./templates/virtualModuleModernEntry.js"
  },
  "files": [
    "dist/**/*",
    "templates/**/*",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@storybook/core-webpack": "^10.2.19 || ^11.0.0-0",
    "cjs-module-lexer": "^2.2.0",
    "css-loader": "^7.1.4",
    "es-module-lexer": "^2.0.0",
    "magic-string": "^0.30.21",
    "pathe": "^2.0.3",
    "slash": "^5.1.0",
    "style-loader": "^4.0.0",
    "pretty-hrtime": "^1.0.3",
    "sirv": "^3.0.2",
    "webpack-dev-middleware": "^7.4.5",
    "webpack-hot-middleware": "^2.26.1"
  },
  "devDependencies": {
    "@rspack/core": "^1.7.9",
    "@types/node": "^22.0.0",
    "@types/pretty-hrtime": "^1.0.3",
    "@types/webpack-hot-middleware": "^2.25.12",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@rspack/core": "^1.0.0",
    "storybook": "^10.0.0 || ^11.0.0-0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
