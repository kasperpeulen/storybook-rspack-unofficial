{
  "name": "storybook-builder-rspack-unofficial",
  "version": "0.0.1",
  "description": "A Storybook builder that uses rspack directly",
  "keywords": [
    "storybook",
    "storybook-builder",
    "rspack",
    "builder",
    "bundler"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./loaders/export-order-loader": "./dist/loaders/export-order-loader.js",
    "./loaders/storybook-mock-transform-loader": "./dist/loaders/storybook-mock-transform-loader.js",
    "./loaders/rspack-automock-loader": "./dist/loaders/rspack-automock-loader.js",
    "./package.json": "./package.json",
    "./presets/custom-rspack-preset": "./dist/presets/custom-rspack-preset.js",
    "./presets/preview-preset": "./dist/presets/preview-preset.js",
    "./templates/preview.ejs": "./templates/preview.ejs",
    "./templates/virtualModuleModernEntry.js": "./templates/virtualModuleModernEntry.js"
  },
  "files": [
    "dist/**/*",
    "templates/**/*",
    "README.md",
    "*.js",
    "*.d.ts",
    "!src/**/*"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@storybook/core-webpack": "^10.0.0",
    "cjs-module-lexer": "^1.2.3",
    "css-loader": "^7.1.2",
    "es-module-lexer": "^1.5.0",
    "magic-string": "^0.30.5",
    "pathe": "^2.0.0",
    "slash": "^5.0.0",
    "style-loader": "^4.0.0",
    "ts-dedent": "^2.0.0",
    "pretty-hrtime": "^1.0.3",
    "sirv": "^2.0.4",
    "webpack-dev-middleware": "^6.1.2",
    "webpack-hot-middleware": "^2.25.1"
  },
  "devDependencies": {
    "@rspack/core": "^1.3.0",
    "@types/node": "^22.0.0",
    "@types/pretty-hrtime": "^1.0.0",
    "@types/webpack-hot-middleware": "^2.25.6",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@rspack/core": "^1.0.0",
    "storybook": "^10.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
