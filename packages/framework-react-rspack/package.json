{
  "name": "storybook-react-rspack",
  "version": "0.1.0",
  "description": "Storybook framework for React with rspack",
  "keywords": [
    "storybook",
    "storybook-framework",
    "react",
    "rspack"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./preset": {
      "types": "./dist/preset.d.ts",
      "default": "./dist/preset.js"
    },
    "./loaders/react-docgen-loader": "./dist/loaders/react-docgen-loader.js",
    "./loaders/react-docgen-typescript-loader": "./dist/loaders/react-docgen-typescript-loader.js",
    "./plugins/react-docgen-typescript-worker": "./dist/plugins/react-docgen-typescript-worker.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "*.js",
    "*.d.ts",
    "!src/**/*"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@rollup/pluginutils": "^5.1.0",
    "@storybook/react": "^10.0.0",
    "storybook-builder-rspack": "workspace:*",
    "empathic": "^1.0.0",
    "magic-string": "^0.30.5",
    "react-docgen": "^7.1.1",
    "react-docgen-typescript": "^2.2.2",
    "resolve": "^1.22.8",
    "tsconfig-paths": "^4.2.0"
  },
  "devDependencies": {
    "@rspack/core": "^1.3.0",
    "@types/react": "^19.0.0",
    "@types/resolve": "^1.20.6",
    "react": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@rspack/core": "^1.0.0",
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "storybook": "^10.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
